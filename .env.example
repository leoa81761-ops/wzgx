# 复制为 .env 后按需修改。不要把真实密钥提交到仓库。

# Docker Compose 使用 Postgres。本机不用 Docker 时可以改成 SQLite：
# DATABASE_URL=sqlite:///./data/dev.db
DATABASE_URL=postgres://gonghao:gonghao@db:5432/gonghao?sslmode=disable

# 用于加密公众号 AppSecret 和模型 API Key。生产环境必须换成足够长的随机字符串。
MASTER_KEY=dev-master-key-change-me
JWT_SECRET=dev-jwt-secret-change-me

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456

# mock：不访问外部服务。live：按后台配置调用真实接口。
WECHAT_MODE=mock
WECHAT_API_BASE=https://api.weixin.qq.com
LLM_MODE=mock

# 展示在绑定教程里，供用户加入微信 IP 白名单。
PUBLIC_EGRESS_IP=

# 失败和高风险通知的外发地址。留空则只记站内通知。
NOTIFY_WEBHOOK_URL=

# 同一条通知的邮件。SMTP_HOST 留空则不发信。账号不是邮箱时也不发。不要把真实密码提交到仓库。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 认证号自动发布每天每号次数。默认 20，最大 100。计划里的开关默认关闭。
PUBLISH_DAILY_CAP=20

# 在线支付。一组没配齐时，定价页仍显示「即将开通」。不要把真实密钥提交到仓库。
# PAY_SANDBOX=1 只用于测试，不会访问微信或支付宝。生产不要开。
PAY_SANDBOX=
# 微信支付（Native 扫码）要同时填写下面这些。私钥、平台证书二选一：直接贴 PEM，或给文件路径。
WXPAY_MCH_ID=
WXPAY_APP_ID=
WXPAY_MCH_SERIAL=
WXPAY_API_V3_KEY=
WXPAY_PRIVATE_KEY=
WXPAY_PRIVATE_KEY_FILE=
WXPAY_PLATFORM_CERT=
WXPAY_PLATFORM_CERT_FILE=
WXPAY_NOTIFY_URL=
WXPAY_API_BASE=https://api.mch.weixin.qq.com
# 支付宝当面付要同时填写 AppId、私钥、公钥和通知地址。电脑网站支付还要 RETURN_URL。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_FILE=
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_FILE=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 可选，单位是分。留空用默认：普通版 3000/29900，高级版 9900/99000，买断 300000。
PAY_PRICE_STANDARD_MONTH=
PAY_PRICE_STANDARD_YEAR=
PAY_PRICE_PREMIUM_MONTH=
PAY_PRICE_PREMIUM_YEAR=
PAY_PRICE_LIFETIME=

SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_SECONDS=60
# 推理模型单篇可能超过 15 分钟。低于这个时间的「生成中」任务不要被重新入队。
STALE_TASK_SECONDS=3600

# 4 核 4 GB 上的建议值。同等限制下 4096 路生成全部成功，等模型重叠时峰值约 520 MiB。
# 1024 给真实正文和更长的模型等待留余量。需要更高时可以改到 4096。
MAX_CONCURRENCY=1024
DB_MAX_OPEN_CONNS=16
DB_MAX_IDLE_CONNS=8

# 真实连通测试（gonghao probe 或后台「真实连通测试」）才会读取。留空即可。
WX_APP_ID=
WX_APP_SECRET=
LLM_PROTOCOL=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_EXTRA_HEADERS=
PROBE_DIRECTION=职场成长
